# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# TokenPort 品牌化文档：合并上游时始终保留 fork 版本（需 merge.ours.driver=true，
# 由 token-platform 同步脚本与 CI 工作流幂等设置）。策略详见 scripts/sync/tokenport-sync-policy.json
README.md merge=ours
README_CN.md merge=ours
